{
  "name": "log4lib",
  "image": "docker.io/cloudmeshswnetworks/dcbuilder:v1.0.0",
  "runArgs": [
    "--name=log4lib",
    "--network=sonar-bridge"
  ],
  "customizations": {
    "jetbrains": {
      "backend": "IntelliJ",
      "settings": {
        "com.intellij:app:BuiltInServerOptions.builtInServerPort": 59662,
        "com.intellij:app:HttpConfigurable.use_proxy_pac": true
      },
      "plugins": []
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/git": {}
  },
  "remoteUser": "ubuntu"
}
